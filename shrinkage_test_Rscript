library(ggplot2)
k <- 10   # numero di PC da usare nella distanza

read_evec <- function(f) {
  x <- read.table(f, skip = 1, stringsAsFactors = FALSE)
  d <- as.data.frame(x[, 2:(k + 1)])
  names(d) <- paste0("PC", 1:k)
  d$ID  <- x[, 1]
  d$pop <- x[, ncol(x)]
  d
}

a <- read_evec("0iter_modernWEandAncient_noshrink_evecout.txt")
b <- read_evec("0iter_modernWEandAncient_evecout.txt")
b <- b[match(a$ID, b$ID), ]            # stesso ordine dei campioni
stopifnot(!anyNA(b$ID))

pc <- paste0("PC", 1:k)
A <- as.matrix(a[, pc]); B <- as.matrix(b[, pc])

# correggi eventuali inversioni di segno degli assi
for (j in 1:k) if (cor(A[, j], B[, j]) < 0) B[, j] <- -B[, j]

# spostamento per campione
res <- data.frame(ID = a$ID, pop = a$pop,
                  d_all = sqrt(rowSums((A - B)^2)),
                  d_12  = sqrt(rowSums((A[, 1:2] - B[, 1:2])^2)))

# unisci il numero di SNP
snp <- read.table("snps.txt", header = TRUE)   # colonne: ID, nSNP
res <- merge(res, snp, by = "ID")

# 1) spostamento vs copertura
print(cor.test(res$nSNP, res$d_12, method = "spearman"))
ggplot(res, aes(nSNP, d_12)) +
  geom_point(alpha = .7) +
  geom_smooth(method = "loess", se = TRUE) +
  scale_x_log10() +
  labs(x = "SNP coperte (log10)", y = "Spostamento in PC1-PC2")

# 2) riepilogo e Procrustes globale
summary(res$d_12)
library(vegan)
protest(A, B, permutations = 999)

# 3) frecce da senza shrink a con shrink (solo campioni antichi)
arr <- data.frame(x0 = A[, 1], y0 = A[, 2], x1 = B[, 1], y1 = B[, 2], ID = a$ID)
arr <- merge(arr, snp, by = "ID")
arr <- subset(arr, nSNP < 200000)    # soglia di esempio: adattala
ggplot() +
  geom_point(data = data.frame(x = A[, 1], y = A[, 2]), aes(x, y), colour = "grey80") +
  geom_segment(data = arr, aes(x = x0, y = y0, xend = x1, yend = y1),
               arrow = arrow(length = unit(.15, "cm")))

